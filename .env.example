# Число последовательных запросов. От 1 до 100, по умолчанию 10.
REQUEST_COUNT=10

# Сколько миллисекунд ждать один ответ. От 1 до 600000, по умолчанию 120000.
REQUEST_TIMEOUT_MS=120000

# silent, error, info или debug. Логи пишутся в stderr.
LOG_LEVEL=info

# Заголовок User-Agent, одна строка до 128 символов.
USER_AGENT=spid-test/1.0
